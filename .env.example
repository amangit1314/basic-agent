# =============================================================================
# Auction Notice Extractor - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION
# Choose ONE of the following options:
# -----------------------------------------------------------------------------

# OPTION 1: OpenAI (Recommended for best results)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Specify which model to use (default: gpt-4o-mini)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL_NAME=gpt-4o-mini

# -----------------------------------------------------------------------------
# OPTION 2: Anthropic Claude
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# -----------------------------------------------------------------------------
# OPTION 3: Google Gemini
# Get your API key from: https://makersuite.google.com/app/apikey
# GOOGLE_API_KEY=your-google-api-key-here

# -----------------------------------------------------------------------------
# OPTION 4: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# -----------------------------------------------------------------------------
# OPTION 5: Local LLM via Ollama (FREE - No API key needed!)
# 1. Install Ollama: https://ollama.ai/download
# 2. Run: ollama pull llama3.2 (or another model)
# 3. Set the model name below
# OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# ADVANCED: CrewAI Configuration (Optional)
# -----------------------------------------------------------------------------

# Enable verbose logging for debugging
# CREWAI_VERBOSE=true

# Set max iterations for agent reasoning
# CREWAI_MAX_ITER=15
